<suki:SukiWindow xmlns="https://github.com/avaloniaui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:vm="using:SquarePixel.ViewModels"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
                 x:Class="SquarePixel.Views.MainWindow"
                 x:DataType="vm:MainWindowViewModel"
                 xmlns:suki="https://github.com/kikipoulet/SukiUI"
                 BackgroundStyle="GradientDarker"
                 xmlns:views="clr-namespace:SquarePixel.Views"
                 Icon="/Assets/avalonia-logo.ico"
                 Title="SquarePixel">

    <suki:SukiWindow.Hosts>
               <suki:SukiDialogHost Manager="{Binding DialogManager}"/>
           </suki:SukiWindow.Hosts>
    
    
  <suki:SukiSideMenu>
      <suki:SukiSideMenu.Items>
          <suki:SukiSideMenuItem Header="Gallery">
              <suki:SukiSideMenuItem.PageContent>
                  <views:ImageGallery DataContext="{Binding GalleryViewModel}"/>
              </suki:SukiSideMenuItem.PageContent>e
          </suki:SukiSideMenuItem>
      </suki:SukiSideMenu.Items>
  </suki:SukiSideMenu>
</suki:SukiWindow>
