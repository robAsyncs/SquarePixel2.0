<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:SquarePixel.Views"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:vm="clr-namespace:SquarePixel.ViewModels"
             x:DataType="vm:GalleryViewModel"
             x:Class="SquarePixel.Views.GalleryView">
     
    <Grid RowDefinitions="100, *" ColumnDefinitions="*, Auto" Margin="10" MinWidth="200" MinHeight="200" ShowGridLines="False">
       
        
        
        
        <Expander Grid.Row="0" Grid.RowSpan="2" MinWidth="500"
                  Grid.Column="1" ExpandDirection="Left" IsExpanded="True"
                  Header="Image Gallery" HorizontalContentAlignment="Stretch">
            <views:ImageDbView DataContext="{Binding ImageDbViewModel}"/>
        </Expander>
        
        
        
    </Grid>
    
</UserControl>
