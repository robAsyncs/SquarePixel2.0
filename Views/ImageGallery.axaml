<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:SquarePixel.ViewModels"
             xmlns:suki="https://github.com/kikipoulet/SukiUI"
             xmlns:squarePixel="clr-namespace:SquarePixel"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="1000"
             x:DataType="viewModels:GalleryViewModel"
             x:Class="SquarePixel.Views.ImageGallery"
             x:CompileBindings="True">
    
    
    <UserControl.Resources>
        <squarePixel:StringToImageSourceConverter x:Key="ImgConverter"/>
    </UserControl.Resources>

    
    <Grid RowDefinitions="40, Auto" Margin="10">
        <Button  Background="Orange" Width="250" HorizontalAlignment="Left"
            Content="Load Images from Folder" Command="{Binding LoadGalleryFolderCommand}"/>
        
        
        <WrapPanel Margin="20" HorizontalAlignment="Center" VerticalAlignment="Top">
            <ItemsRepeater ItemsSource="{Binding ImageCollection}" >
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate>
                        <suki:GlassCard IsOpaque="True" IsInteractive="True" BorderThickness="2" 
                                        BorderBrush="Red" MaxWidth="350" MaxHeight="250" Padding="5">
                            <Grid RowDefinitions="Auto,*, 50" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Image Grid.Row="0" Source="{Binding Source, 
                            Converter={StaticResource ImgConverter}}" Height="100"/>
                                <Label Grid.Row="2" FontWeight="SemiBold" Content="{Binding ImageDescription}" 
                                       FontSize="18" VerticalAlignment="Bottom"/>
                            </Grid>
                        </suki:GlassCard>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </WrapPanel>
    </Grid>
</UserControl>
